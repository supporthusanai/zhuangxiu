# ========================================
# Docker Compose 环境配置示例
# ========================================
#
# 使用说明：
# 1. 复制此文件为 .env（在项目根目录）
# 2. 填写所有配置项
# 3. 运行: docker-compose up -d
#
# ========================================

# ========================================
# 服务端口
# ========================================
PORT=3000

# ========================================
# Node 环境
# ========================================
NODE_ENV=production

# ========================================
# MongoDB 配置
# ========================================
MONGODB_USER=admin
MONGODB_PASSWORD=your-mongodb-password-here

# ========================================
# Redis 配置
# ========================================
REDIS_PASSWORD=your-redis-password-here

# ========================================
# JWT 配置 (REQUIRED)
# ========================================
# 生成安全密钥：
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-here-PLEASE-CHANGE
JWT_EXPIRES_IN=7d

# ========================================
# 微信小程序配置 (REQUIRED)
# ========================================
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# ========================================
# CORS 配置
# ========================================
# 多个域名用逗号分隔
ALLOWED_ORIGINS=http://localhost:10200,https://yourdomain.com
