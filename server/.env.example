# ========================================
# 装修小程序后端环境配置
# ========================================
#
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写所有必需的配置项（标记为 REQUIRED）
# 3. 请勿将 .env 文件提交到版本控制系统
#
# ========================================

# ========================================
# 服务器配置
# ========================================
PORT=3000
NODE_ENV=development

# ========================================
# 数据库配置
# ========================================

# MongoDB 配置
MONGODB_URI=mongodb://localhost:27017/zhuangxiu
MONGODB_USER=
MONGODB_PASSWORD=

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# JWT 认证配置 (REQUIRED - 必须配置)
# ========================================
# ⚠️  警告：请勿使用默认值！
# 生成安全密钥的方法：
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
JWT_SECRET=your-secret-key-here-PLEASE-CHANGE-THIS
JWT_EXPIRES_IN=7d

# ========================================
# 文件上传配置
# ========================================
UPLOAD_DIR=uploads
# 文件大小限制（字节）：5MB = 5242880
MAX_FILE_SIZE=5242880

# ========================================
# 微信小程序配置 (REQUIRED - 必须配置)
# ========================================
# 在微信公众平台获取：https://mp.weixin.qq.com/
#
WECHAT_APP_ID=your-app-id
WECHAT_APP_SECRET=your-app-secret

# ========================================
# CORS 配置
# ========================================
# 多个域名用逗号分隔，例如：
# ALLOWED_ORIGINS=http://localhost:10200,https://yourdomain.com
#
ALLOWED_ORIGINS=http://localhost:10200

# ========================================
# 日志配置
# ========================================
LOG_DIR=logs
